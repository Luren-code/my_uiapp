{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uv-(.*)": "@/uni_modules/uv-ui/components/uv-$1/uv-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "EOI职业查询"
      }
    },
    {
      "path": "pages/EOI-ranking/ranking",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "EOI排名"
      }
    },
    {
      "path": "pages/EOI-resources/resources",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "EOI资源"
      }
    },
    {
      "path": "pages/landing-center/landing-center",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "上岸中心"
      }
    },
    {
      "path": "pages/index/EOI-calculator/calculator",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "EOI分数计算"
      }
    },
    {
      "path": "pages/index/EOI-guide/guide",
      "style": {
        "navigationStyle": "custom", 
        "navigationBarTitleText": "新手入门"
      }
    },
    {
      "path": "pages/index/EOI-trends/trends",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "递交趋势"
      }
    },
    {
      "path": "pages/occupation-detail/detail",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "职业详情"
      }
    }
  ],
  "globalStyle": {
    "navigationStyle": "default",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#4A90E2",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "EOI职业",
        "iconPath": "static/tab1.png",
        "selectedIconPath": "static/tab1-active.png"
      },
      {
        "pagePath": "pages/EOI-ranking/ranking",
        "text": "EOI排名",
        "iconPath": "static/tab2.png",
        "selectedIconPath": "static/tab2-active.png"
      },
      {
        "pagePath": "pages/EOI-resources/resources",
        "text": "EOI资源",
        "iconPath": "static/tab3.png",
        "selectedIconPath": "static/tab3-active.png"
      },
      {
        "pagePath": "pages/landing-center/landing-center",
        "text": "上岸中心",
        "iconPath": "static/tab4.png",
        "selectedIconPath": "static/tab4-active.png"
      }
    ]
  }
}